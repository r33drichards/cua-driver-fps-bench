@@ -2500,6 +2500,20 @@ pub fn send_drag_xtest_desktop(
 
 /// Send a named key press to a window.
 pub fn send_key(xid: u64, key: &str, modifiers: &[&str]) -> Result<()> {
+    // XTEST is accepted by browsers and resolves the key through the server's
+    // active keymap. It is safe for background mode when this exact target
+    // already owns focus because no activation or focus change is required.
+    let display = open_display().ok();
+    let target_is_focused = display
+        .map(|display| {
+            let focused = x11_focus_is_within(display, xid as x11::xlib::Window);
+            unsafe { x11::xlib::XCloseDisplay(display) };
+            focused
+        })
+        .unwrap_or(false);
+    if target_is_focused {
+        return send_key_xtest(key, modifiers);
+    }
     send_key_to_target(xid, None, key, modifiers)
 }
 
