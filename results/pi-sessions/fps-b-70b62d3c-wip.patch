+/// Query the real X11 pointer's current screen-absolute position (root_x, root_y).
+pub fn query_pointer_root() -> Result<(i32, i32)> {
+    let (conn, screen_num) = connect_x11_for_input()?;
+    let root = conn.setup().roots[screen_num].root;
+    let reply = conn.query_pointer(root)?.reply()?;
+    Ok((reply.root_x as i32, reply.root_y as i32))
+}
+
+/// Inject a *relative* real-pointer motion of (dx, dy) via XTest.
+///
+/// Absolute XTest warps (`send_move_xtest_desktop`) do not yield the expected
+/// `movementX`/`movementY` under a browser's Pointer Lock: the page sees a
+/// tiny fraction of the intended delta (observed mouse_ratio ~0.04 for the FPS
+/// bench). Pointer Lock re-anchors the cursor to its lock center after each
+/// event, so the only reliable way to make the page report a specific
+/// `movementX` is to move the pointer by `delta` *from wherever it currently
+/// sits*: query the real pointer, warp to `(cur + delta)`. The browser then
+/// computes `movementX = (cur + delta) - cur = delta` regardless of where it
+/// re-anchored. This is the X11 analogue of a relative device motion event.
+pub fn send_move_xtest_relative(dx: i32, dy: i32) -> Result<()> {
+    use x11rb::protocol::xtest::ConnectionExt as _;
+    let (conn, screen_num) = connect_x11_for_input()?;
+    let root = conn.setup().roots[screen_num].root;
+    let cur = conn.query_pointer(root)?.reply()?;
+    let nx = cur.root_x as i32 + dx;
+    let ny = cur.root_y as i32 + dy;
+    conn.xtest_fake_input(MOTION_NOTIFY_EVENT, 0, 0, root, nx as i16, ny as i16, 0)?;
+    conn.flush()?;
+    let _ = conn.get_input_focus()?.reply();
+    Ok(())
+}
